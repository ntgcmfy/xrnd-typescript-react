# このファイルをコピーして .env を作り、値を入れる（.env は Git に入れない）

# Neon の接続文字列（開発用のブランチ）
# アプリからの接続: Neon の Connect 画面で Connection pooling をオンにした文字列（ホスト名に -pooler が付く）
DATABASE_URL=""
# マイグレーション用: Connection pooling をオフにした文字列（ホスト名に -pooler が付かない）
DATABASE_URL_UNPOOLED=""

# OpenAI の API キー（メンターから配られたもの。工程4で使う）
OPENAI_API_KEY=""
# 使うモデル（メンターが指定したもの。工程4で使う）
OPENAI_MODEL=""
# true にすると、OpenAI を呼ばずに決まった出力を返す（テストで使う。工程4で使う）
AI_MOCK="false"

# ログインの土台（Better Auth）
# 秘密の文字列（npx auth@latest secret で作れる。32文字以上）
BETTER_AUTH_SECRET=""
# アプリの URL
BETTER_AUTH_URL="http://localhost:3000"
